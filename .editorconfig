# Keeps formatting consistent across everyone's IDE (IntelliJ, VS Code, Eclipse all support it)
# so pull request diffs only show real changes.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cmd]
end_of_line = crlf
